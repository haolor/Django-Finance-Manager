# Copy thành .env và điền giá trị thật. Dùng bởi docker compose và chạy local.

# ==== JWT (chia sẻ giữa api-gateway và mọi service) ====
# Tối thiểu 32 ký tự cho HS256.
JWT_SECRET=please-change-me-to-a-32-bytes-minimum-secret-key

# ==== PostgreSQL (mỗi service một DB) ====
POSTGRES_PASSWORD=postgres

# ==== api-gateway ====
GATEWAY_ALLOWED_ORIGINS=*

# ==== ai-service / Vertex AI Gemini ====
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
# Đặt path tới file service-account JSON khi mount vào container ai-service
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# ==== notification-service / SMTP ====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
